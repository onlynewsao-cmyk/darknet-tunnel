<%- include('../partials/head') %>
<div class="app-shell">
  <%- include('../partials/sidebar') %>
  <main class="main">
    <header class="page-header">
      <div>
        <h1>🕸️ Central de Contactos</h1>
        <p class="muted">Contactos capturados dos grupos (sem duplicados) — v12.9.11 · alimentada por <code>.capturartodos</code> / <code>.capturar &lt;nº&gt;</code> no WhatsApp</p>
      </div>
    </header>

    <!-- ═══ v12.9.35: GRUPOS DO BOT AO VIVO — captura individual/comunidade/todos ═══ -->
    <div class="card">
      <h2>🎯 Grupos do bot <small class="muted">ao vivo · captura um a um, por comunidade ou tudo</small></h2>
      <div class="button-row" style="margin-bottom:0.8rem">
        <button class="btn btn-sm btn-secondary" onclick="vivosCarregar(this)">🔄 Carregar grupos</button>
        <button class="btn btn-sm btn-primary" onclick="vivosCapturarTudo(this)">📥 Capturar TODOS</button>
        <input type="text" id="vivosBusca" placeholder="buscar grupo…" style="flex:1;min-width:150px;padding:0.45rem 0.7rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-2);color:var(--text)" oninput="vivosRender()">
      </div>
      <p class="muted small" id="vivosStatus" style="margin-bottom:0.6rem">Carrega os grupos para ver e capturar — 🏘️ marca comunidades (captura pai + todos os subgrupos).</p>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:0.85rem">
          <thead><tr><th style="text-align:left">Grupo</th><th>👥</th><th></th></tr></thead>
          <tbody id="vivosTbody"><tr><td colspan="3" class="muted">— carrega os grupos do bot —</td></tr></tbody>
        </table>
      </div>
    </div>

    <!-- ═══ v12.9.36: PAÍSES REAIS com totais — addcentral <dest> de pais:<nome> ═══ -->
    <div class="card">
      <h2>🌍 Países <small class="muted">números reais na base — usa <code>addcentral &lt;dest&gt; de pais:&lt;nome&gt;</code> no WhatsApp</small></h2>
      <div id="paisesBox" class="muted small">a carregar países…</div>
    </div>

    <div class="card">
      <h2>📊 Resumo</h2>
      <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr))">
        <div class="card" style="margin:0"><h3 style="font-size:1.6rem;margin:0">📇 <%= total %></h3><small class="muted">contactos únicos</small></div>
        <div class="card" style="margin:0"><h3 style="font-size:1.6rem;margin:0">📋 <%= nGrupos %></h3><small class="muted">grupos conhecidos</small></div>
        <div class="card" style="margin:0"><h3 style="font-size:1.6rem;margin:0">🕒 <%= updatedAt ? new Date(updatedAt).toLocaleString('pt-PT') : '—' %></h3><small class="muted">última captura</small></div>
        <div class="card" style="margin:0"><h3 style="font-size:1.6rem;margin:0" id="ddCard">🌍 …</h3><small class="muted">DDDs / países</small></div>
        <div class="card" style="margin:0"><h3 style="font-size:1.6rem;margin:0" id="slotsCard">🧱 …</h3><small class="muted">números que capturaram</small></div>
      </div>
      <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn btn-primary" onclick="capturarTodosSlots(this)">🕸️ Capturar com TODOS os números</button>
        <a class="btn" href="/api/central/csv">⬇️ Exportar CSV (com DDD)</a>
        <button class="btn" onclick="centralRefresh()">🔄 Recarregar</button>
        <button class="btn btn-danger" onclick="centralLimpar()">🗑️ Limpar base</button>
      </div>
      <small class="muted" id="multiStatus">A captura com todos os números liga cada slot (EM USO + guardadas) e junta os membros dos grupos de cada um — sem duplicados.</small>
      <small class="muted">No WhatsApp: <code>.central</code> (menu), <code>.gruposbot</code>, <code>.capturartodos</code>, <code>.contactos</code>, <code>.addcentral &lt;dest&gt; [de &lt;nº|todos&gt;]</code>, <code>.comunidade</code> — tudo só do dono.</small>
    </div>

    <div class="card">
      <h2>🌍 Por DDD / país <small class="muted">clica para filtrar a tabela</small></h2>
      <div id="ddChips" style="display:flex;gap:8px;flex-wrap:wrap"></div>
    </div>

    <div class="card">
      <h2>🧱 Por número (slot) <small class="muted">qual número viu quem</small></h2>
      <div id="slotChips" style="display:flex;gap:8px;flex-wrap:wrap"></div>
    </div>

    <div class="card">
      <h2>📋 Grupos capturados</h2>
      <table class="table">
        <thead><tr><th>#</th><th>Grupo</th><th>Contactos capturados</th><th>Membros</th><th>Capturado</th></tr></thead>
        <tbody>
          <% grupos.forEach((g, i) => { %>
            <tr><td><%= i + 1 %></td><td><%= g.nome %></td><td><b><%= g.capturados %></b></td><td><%= g.membros %></td><td><%= new Date(g.ts).toLocaleDateString('pt-PT') %></td></tr>
          <% }) %>
          <% if (!grupos.length) { %><tr><td colspan="5" class="muted">Nada capturado ainda — corre <code>.capturartodos</code> no WhatsApp.</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <p id="lidsBox" class="muted small" style="margin-bottom:0.6rem"></p>

    <div class="card">
      <h2>📇 Contactos</h2>
      <div class="form-group"><input type="text" id="centralBusca" placeholder="🔍 procurar por número ou nome…" oninput="centralFiltrar()" style="max-width:340px" /></div>
      <table class="table" id="centralTabela">
        <thead><tr><th>Número</th><th>Nome</th><th>DDD / país</th><th>Visto por</th><th>Grupos</th><th>Capturado</th><th></th></tr></thead>
        <tbody id="centralTbody"><tr><td colspan="8" class="muted">a carregar…</td></tr></tbody>
      </table>
      <small class="muted" id="centralCount"></small>
    </div>
  </main>
</div>

<script>
let _centralDados = [];
let _filtroDdd = '';
// ═══ v12.9.36: PAGINAÇÃO no SERVIDOR (1M+ contactos) ═══
let _pagina = 1, _paginas = 1, _totalBase = 0, _totalFiltrado = 0, _filtroPais = '';
async function centralRefresh() {
  const busca = (document.getElementById('centralBusca').value || '').trim();
  const qs = new URLSearchParams({ pag: _pagina, porPagina: 100 });
  if (busca) qs.set('busca', busca);
  if (_filtroDdd) qs.set('ddd', _filtroDdd);
  if (_filtroPais) qs.set('pais', _filtroPais);
  const r = await fetch('/api/central/state?' + qs).then(x => x.json()).catch(() => null);
  if (!r) return;
  _centralDados = (r.contactos || []).map(c => ({ ...c, busca: (c.num + ' ' + (c.nome || '')).toLowerCase() }));
  _pagina = r.pagina || 1; _paginas = r.paginas || 1; _totalBase = r.total || 0; _totalFiltrado = r.totalFiltrado || 0;
  lidsInfo(r.lids || 0);
  const dd = document.getElementById('ddCard');
  if (dd) dd.textContent = '🌍 ' + (r.ddds || []).length;
  const sc2 = document.getElementById('slotsCard');
  if (sc2) sc2.textContent = '🧱 ' + (r.slots || []).length;
  renderDds(r.ddds || []);
  renderSlots(r.slots || []);
  centralRender();
}
async function paisesCarregar() {
  const box = document.getElementById('paisesBox');
  try {
    const r = await fetch('/api/central/paises').then(x => x.json());
    if (!r.ok) { box.textContent = '❌ falhou a carregar países'; return; }
    const com = (r.naBase || []).filter(p => p.total > 0);
    if (!com.length) { box.textContent = 'Ainda sem países na base — captura grupos e volta.'; return; }
    box.innerHTML = com.map(p => `<button class="btn btn-sm ${_filtroPais === p.pais ? 'btn-primary' : 'btn-ghost'}" style="margin:.15rem" onclick="paisFiltrar('${String(p.pais).replace(/'/g, "\\'")}')">\${p.pais} <b>\${p.total}</b></button>`).join(' ') + (_filtroPais ? ' <button class="btn btn-sm btn-danger" onclick="paisFiltrar(\'\')">✕ limpar país</button>' : '');
  } catch (e) { box.textContent = '❌ ' + e.message; }
}
function paisFiltrar(nome) { _filtroPais = nome || ''; _pagina = 1; paisesCarregar(); centralRefresh(); }
function renderDds(ddds) {
  const el = document.getElementById('ddChips');
  if (!el) return;
  if (!ddds.length) { el.innerHTML = '<small class="muted">Sem contactos ainda.</small>'; return; }
  el.innerHTML = ddds.map(d => `<button class="btn btn-sm" data-ddd="${d.rotulo}" onclick="filtrarDdd('${d.rotulo}', this)" style="<%= 'margin:2px' %>">🌍 <b>${d.rotulo}</b> ${d.pais} · ${d.total}</button>`).join(' ');
}
function renderSlots(slots) {
  const el = document.getElementById('slotChips');
  if (!el) return;
  if (!slots.length) { el.innerHTML = '<small class="muted">Ainda sem captura por número — usa a captura com TODOS os números.</small>'; return; }
  el.innerHTML = slots.map(s => `<span class="badge" style="margin:2px">🧱 SLOT ${s.slot} · ${s.total} contactos</span>`).join(' ');
}
function filtrarDdd(rot, btn) {
  _filtroDdd = _filtroDdd === rot ? '' : rot;
  document.querySelectorAll('#ddChips .btn').forEach(b => b.style.outline = '');
  if (_filtroDdd && btn) btn.style.outline = '2px solid currentColor';
  centralRender();
}
// ═══ v12.9.35: GRUPOS AO VIVO — listar, capturar um, comunidade ou todos ═══
let _vivos = [], _vivosEmCurso = false;
async function vivosCarregar(btn) {
  if (btn) { btn.disabled = true; btn.textContent = '⏳ a carregar…'; }
  const st = document.getElementById('vivosStatus');
  try {
    const r = await fetch('/api/central/grupos-vivos').then(x => x.json());
    if (!r.ok) { st.textContent = '❌ ' + (r.motivo === 'bot-nao-conectado' ? 'o bot não está conectado — conecta primeiro' : (r.motivo || 'falhou')); }
    else { _vivos = r.grupos || []; st.textContent = `✅ ${r.total} grupo(s) encontrados. 🏘️ = comunidade (captura pai + subgrupos).`; vivosRender(); }
  } catch (e) { st.textContent = '❌ ' + e.message; }
  if (btn) { btn.disabled = false; btn.textContent = '🔄 Carregar grupos'; }
}
function vivosRender() {
  const tb = document.getElementById('vivosTbody');
  const termo = (document.getElementById('vivosBusca').value || '').toLowerCase().trim();
  const lista = termo ? _vivos.filter(g => g.nome.toLowerCase().includes(termo) || g.jid.includes(termo)) : _vivos;
  if (!lista.length) { tb.innerHTML = '<tr><td colspan="3" class="muted">' + (_vivos.length ? 'nenhum grupo corresponde à busca' : '— carrega os grupos do bot —') + '</td></tr>'; return; }
  tb.innerHTML = lista.map(g => `<tr>
    <td style="padding:0.45rem 0.5rem">${g.comunidade ? '🏘️ ' : g.pai ? '↳ ' : ''}${String(g.nome).replace(/</g, '&lt;')}${g.comunidade ? ' <b style="color:var(--neon-yellow)">COMUNIDADE</b>' : ''}</td>
    <td style="text-align:center">${g.size}</td>
    <td style="text-align:right;white-space:nowrap">
      <button class="btn btn-sm btn-ghost" onclick="vivosCapturarUm('${g.jid}', this)">📥</button>
      ${g.comunidade ? `<button class="btn btn-sm btn-ghost" title="capturar pai + subgrupos" onclick="vivosCapturarComunidade('${g.jid}', this)">🏘️</button>` : ''}
    </td>
  </tr>`).join('');
}
async function vivosCapturarUm(jid, btn) {
  if (_vivosEmCurso) { toast('Já existe uma captura a correr', 'warn'); return; }
  const st = document.getElementById('vivosStatus');
  if (btn) btn.disabled = true;
  try {
    const r = await fetch('/api/central/capturar-vivo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ jid }) }).then(x => x.json());
    if (!r.ok) { st.textContent = '❌ ' + (r.motivo || 'falhou'); }
    else { st.textContent = `✅ ${r.nome}: +${r.novos} novos · ♻️ ${r.duplicados} duplicados · base com ${r.totalBase} contactos`; centralRefresh(); }
  } catch (e) { st.textContent = '❌ ' + e.message; }
  if (btn) btn.disabled = false;
}
async function vivosCapturarComunidade(jid, btn) {
  return vivosFundo({ comunidade: jid }, btn, 'comunidade (pai + subgrupos)');
}
async function vivosCapturarTudo(btn) {
  if (!confirm('Capturar TODOS os grupos do bot? Corre em segundo plano — podes navegar no dashboard.')) return;
  return vivosFundo({ todos: true }, btn, 'todos os grupos');
}
async function vivosFundo(body, btn, nome) {
  if (_vivosEmCurso) { toast('Já existe uma captura a correr', 'warn'); return; }
  const st = document.getElementById('vivosStatus');
  if (btn) btn.disabled = true;
  try {
    const r = await fetch('/api/central/capturar-vivo-fundo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(x => x.json());
    if (!r.ok) { st.textContent = '❌ ' + (r.motivo || 'falhou'); if (btn) btn.disabled = false; return; }
    _vivosEmCurso = true;
    st.textContent = `⏳ Captura de ${nome} em segundo plano (${r.total} grupos)…`;
    const _iv = setInterval(async () => {
      const p = await fetch('/api/central/captura-viva-progresso').then(x => x.json()).catch(() => null);
      if (!p) return;
      if (p.emCurso) { st.textContent = `⏳ ${p.feitos}/${p.total} grupos · +${p.novos} contactos novos · ${p.grupo || '…'}`; return; }
      clearInterval(_iv);
      _vivosEmCurso = false;
      const rs = p.resultados || {};
      st.textContent = rs.ok ? `✅ ${rs.grupos} grupo(s) capturados · +${rs.novos} novos · base com ${rs.totalBase} contactos` + (rs.falharam ? ` · ⚠️ ${rs.falharam} falharam` : '') : '❌ ' + (rs.motivo || 'falhou');
      if (btn) btn.disabled = false;
      centralRefresh();
    }, 3000);
  } catch (e) { st.textContent = '❌ ' + e.message; if (btn) btn.disabled = false; }
}
async function capturarTodosSlots(btn) {
  if (!confirm('Ligar cada número (EM USO + guardadas) e capturar os grupos de TODOS? Com muitos grupos corre em segundo plano — podes fechar esta página.')) return;
  const st = document.getElementById('multiStatus');
  btn.disabled = true;
  try {
    const r = await fetch('/api/central/capturar-slots', { method: 'POST' }).then(x => x.json());
    if (!r.ok) { st.textContent = '❌ ' + (r.erro || r.motivo || 'falhou'); btn.disabled = false; return; }
    st.textContent = '⏳ Captura em segundo plano…';
    // v12.9.34: segue o progresso — suporta 1000+ grupos sem timeout de HTTP
    const _iv = setInterval(async () => {
      const p = await fetch('/api/central/captura-progresso').then(x => x.json()).catch(() => null);
      if (!p) return;
      if (p.emCurso) { st.textContent = '⏳ Slot ' + p.slot + ' · ' + p.feitos + '/' + p.total + ' grupos · +' + p.novos + ' contactos novos…'; return; }
      clearInterval(_iv);
      const rs = p.resultados || [];
      const okN = rs.filter(x => !x.erro && x.grupos > 0).length;
      st.textContent = '✅ ' + okN + ' número(s) capturaram · base com ' + p.totalContactos + ' contactos · ' + rs.map(x => 'S' + x.slot + ':' + (x.erro ? '⚠️' : '+' + x.novos)).join(' ');
      btn.disabled = false;
      centralRefresh();
    }, 3000);
  } catch (e) { st.textContent = '❌ ' + e.message; btn.disabled = false; }
}
function centralRender() {
  const tb = document.getElementById('centralTbody');
  if (!_centralDados.length) { tb.innerHTML = '<tr><td colspan="8" class="muted">Nenhum contacto nesta página — limpa a busca/filtros ou captura grupos.</td></tr>'; paginasRender(); return; }
  tb.innerHTML = _centralDados.map(c => `<tr data-busca="${c.busca}">
    <td><code>${c.num}</code></td><td>${c.nome || '—'}</td>
    <td><span class="badge">🌍 ${c.dddRotulo || '—'}</span> <small class="muted">${c.pais || ''}</small></td>
    <td>${(c.slots || []).map(s => `🧱${s}`).join(' ') || '—'}</td>
    <td>${c.grupos || '—'}${c.nGrupos > 3 ? ` <small class="muted">+${c.nGrupos - 3}</small>` : ''}</td>
    <td>${c.ts ? new Date(c.ts).toLocaleDateString('pt-PT') : '—'}</td>
    <td><button class="btn btn-sm btn-ghost" title="tornar usuário do bot" onclick="centralCriarUsuario('${c.num}', this)">👤+</button></td>
    <td><button class="btn btn-sm" onclick="centralRemover('${c.num}')">Remover</button></td></tr>`).join('');
  paginasRender();
}
// v12.9.37: LIDs — aviso + purga
let _lids = 0;
function lidsInfo(n) {
  _lids = n || 0;
  const el = document.getElementById('lidsBox');
  if (!el) return;
  el.innerHTML = _lids > 0
    ? '⚠️ <b>' + _lids.toLocaleString('pt-PT') + '</b> contactos são LIDs (identificadores internos do WhatsApp, <i>não</i> servem para adicionar em grupos — capturados antes da correcção). <button class="btn btn-sm btn-danger" onclick="lidsLimpar(this)">🧹 Remover LIDs</button>'
    : '';
}
async function lidsLimpar(btn) {
  if (!confirm('Remover os ' + _lids + ' contactos LID da base? (não são números reais)')) return;
  btn.disabled = true;
  try {
    const r = await fetch('/api/central/limpar-lids', { method: 'POST' }).then(x => x.json());
    toast('🧹 ' + (r.removidos || 0) + ' LIDs removidos', 'success', 5000);
    lidsInfo(0);
    centralRefresh();
  } catch (e) { toast('❌ ' + e.message, 'error'); }
  btn.disabled = false;
}
function paginasRender() {
  const el = document.getElementById('centralCount');
  const de = _totalFiltrado ? ((pagina offset)) : '';
  el.innerHTML = '— ' + _totalFiltrado.toLocaleString('pt-PT') + ' contacto(s)' + (_totalBase !== _totalFiltrado ? ' (base: ' + _totalBase.toLocaleString('pt-PT') + ')' : '') + (_filtroDdd ? ' · ddd ' + _filtroDdd : '') + (_filtroPais ? ' · ' + _filtroPais : '') + ' — página ' + _pagina + '/' + _paginas +
    ' <button class="btn btn-sm btn-ghost" ' + (_pagina <= 1 ? 'disabled' : '') + ' onclick="paginaIr(' + (_pagina - 1) + ')">‹</button>' +
    ' <button class="btn btn-sm btn-ghost" ' + (_pagina >= _paginas ? 'disabled' : '') + ' onclick="paginaIr(' + (_pagina + 1) + ')">›</button>';
}
function paginaIr(p) { _pagina = Math.min(Math.max(1, p), _paginas); centralRefresh(); }
// v12.9.36: ADICIONAR AOS USUÁRIOS DO BOT
async function centralCriarUsuario(num, btn) {
  if (!confirm('Criar USUÁRIO do bot para ' + num + '?\nGerarei username e senha para enviares à pessoa.')) return;
  if (btn) btn.disabled = true;
  try {
    const r = await fetch('/api/central/criar-usuario', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ num }) }).then(x => x.json());
    if (!r.ok) { toast('❌ ' + (r.erro || 'falhou'), 'error', 6000); }
    else {
      const cred = 'Usuário criado ✅\nusername: ' + r.username + '\nsenha: ' + r.senha + '\n(papel: ' + r.role + ')';
      if (typeof copyText === 'function') copyText(r.username + ' / ' + r.senha, 'Credenciais copiadas');
      alert(cred + '\n\n(credenciais copiadas para a área de transferência)');
    }
  } catch (e) { toast('❌ ' + e.message, 'error'); }
  if (btn) btn.disabled = false;
}
// busca: server-side com debounce (1M+ nunca filtra no cliente)
let _buscaT = null;
function centralFiltrar() {
  clearTimeout(_buscaT);
  _buscaT = setTimeout(() => { _pagina = 1; centralRefresh(); }, 350);
}
async function centralRemover(num) {
  if (!confirm('Remover ' + num + ' da base?')) return;
  await fetch('/api/central/remover', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ num }) });
  centralRefresh();
}
async function centralLimpar() {
  if (!confirm('APAGAR a base TODA?')) return;
  await fetch('/api/central/limpar', { method: 'POST' });
  centralRefresh();
}
// v12.9.24: auto-refresh 30s (a base vive sozinha com a captura passiva)
setInterval(centralRefresh, 30000);
centralRefresh();
paisesCarregar();
</script>
<%- include('../partials/footer') %>
