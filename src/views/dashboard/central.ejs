<%- include('../partials/head') %>
<div class="app-shell">
  <%- include('../partials/sidebar') %>
  <main class="main">
    <header class="page-header">
      <div>
        <h1>🕸️ Central de Contactos</h1>
        <p class="muted">Contactos capturados dos grupos (sem duplicados) — v12.9.11 · alimentada por <code>.capturartodos</code> / <code>.capturar &lt;nº&gt;</code> no WhatsApp</p>
      </div>
    </header>

    <div class="card">
      <h2>📊 Resumo</h2>
      <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr))">
        <div class="card" style="margin:0"><h3 style="font-size:1.6rem;margin:0">📇 <%= total %></h3><small class="muted">contactos únicos</small></div>
        <div class="card" style="margin:0"><h3 style="font-size:1.6rem;margin:0">📋 <%= nGrupos %></h3><small class="muted">grupos conhecidos</small></div>
        <div class="card" style="margin:0"><h3 style="font-size:1.6rem;margin:0">🕒 <%= updatedAt ? new Date(updatedAt).toLocaleString('pt-PT') : '—' %></h3><small class="muted">última captura</small></div>
        <div class="card" style="margin:0"><h3 style="font-size:1.6rem;margin:0" id="ddCard">🌍 …</h3><small class="muted">DDDs / países</small></div>
        <div class="card" style="margin:0"><h3 style="font-size:1.6rem;margin:0" id="slotsCard">🧱 …</h3><small class="muted">números que capturaram</small></div>
      </div>
      <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn btn-primary" onclick="capturarTodosSlots(this)">🕸️ Capturar com TODOS os números</button>
        <a class="btn" href="/api/central/csv">⬇️ Exportar CSV (com DDD)</a>
        <button class="btn" onclick="centralRefresh()">🔄 Recarregar</button>
        <button class="btn btn-danger" onclick="centralLimpar()">🗑️ Limpar base</button>
      </div>
      <small class="muted" id="multiStatus">A captura com todos os números liga cada slot (EM USO + guardadas) e junta os membros dos grupos de cada um — sem duplicados.</small>
      <small class="muted">No WhatsApp: <code>.central</code> (menu), <code>.gruposbot</code>, <code>.capturartodos</code>, <code>.contactos</code>, <code>.addcentral &lt;dest&gt; [de &lt;nº|todos&gt;]</code>, <code>.comunidade</code> — tudo só do dono.</small>
    </div>

    <div class="card">
      <h2>🌍 Por DDD / país <small class="muted">clica para filtrar a tabela</small></h2>
      <div id="ddChips" style="display:flex;gap:8px;flex-wrap:wrap"></div>
    </div>

    <div class="card">
      <h2>🧱 Por número (slot) <small class="muted">qual número viu quem</small></h2>
      <div id="slotChips" style="display:flex;gap:8px;flex-wrap:wrap"></div>
    </div>

    <div class="card">
      <h2>📋 Grupos capturados</h2>
      <table class="table">
        <thead><tr><th>#</th><th>Grupo</th><th>Contactos capturados</th><th>Membros</th><th>Capturado</th></tr></thead>
        <tbody>
          <% grupos.forEach((g, i) => { %>
            <tr><td><%= i + 1 %></td><td><%= g.nome %></td><td><b><%= g.capturados %></b></td><td><%= g.membros %></td><td><%= new Date(g.ts).toLocaleDateString('pt-PT') %></td></tr>
          <% }) %>
          <% if (!grupos.length) { %><tr><td colspan="5" class="muted">Nada capturado ainda — corre <code>.capturartodos</code> no WhatsApp.</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>📇 Contactos</h2>
      <div class="form-group"><input type="text" id="centralBusca" placeholder="🔍 procurar por número ou nome…" oninput="centralRender()" style="max-width:340px" /></div>
      <table class="table" id="centralTabela">
        <thead><tr><th>Número</th><th>Nome</th><th>DDD / país</th><th>Visto por</th><th>Grupos</th><th>Capturado</th><th></th></tr></thead>
        <tbody id="centralTbody"><tr><td colspan="5" class="muted">a carregar…</td></tr></tbody>
      </table>
      <small class="muted" id="centralCount"></small>
    </div>
  </main>
</div>

<script>
let _centralDados = [];
let _filtroDdd = '';
async function centralRefresh() {
  const r = await fetch('/api/central/state').then(x => x.json()).catch(() => null);
  if (!r) return;
  _centralDados = (r.contactos || []).map(c => ({ ...c, busca: (c.num + ' ' + (c.nome || '')).toLowerCase() }));
  const dd = document.getElementById('ddCard');
  if (dd) dd.textContent = '🌍 ' + (r.ddds || []).length;
  const sc2 = document.getElementById('slotsCard');
  if (sc2) sc2.textContent = '🧱 ' + (r.slots || []).length;
  renderDds(r.ddds || []);
  renderSlots(r.slots || []);
  centralRender();
}
function renderDds(ddds) {
  const el = document.getElementById('ddChips');
  if (!el) return;
  if (!ddds.length) { el.innerHTML = '<small class="muted">Sem contactos ainda.</small>'; return; }
  el.innerHTML = ddds.map(d => `<button class="btn btn-sm" data-ddd="${d.rotulo}" onclick="filtrarDdd('${d.rotulo}', this)" style="<%= 'margin:2px' %>">🌍 <b>${d.rotulo}</b> ${d.pais} · ${d.total}</button>`).join(' ');
}
function renderSlots(slots) {
  const el = document.getElementById('slotChips');
  if (!el) return;
  if (!slots.length) { el.innerHTML = '<small class="muted">Ainda sem captura por número — usa a captura com TODOS os números.</small>'; return; }
  el.innerHTML = slots.map(s => `<span class="badge" style="margin:2px">🧱 SLOT ${s.slot} · ${s.total} contactos</span>`).join(' ');
}
function filtrarDdd(rot, btn) {
  _filtroDdd = _filtroDdd === rot ? '' : rot;
  document.querySelectorAll('#ddChips .btn').forEach(b => b.style.outline = '');
  if (_filtroDdd && btn) btn.style.outline = '2px solid currentColor';
  centralRender();
}
async function capturarTodosSlots(btn) {
  if (!confirm('Ligar cada número (EM USO + guardadas) e capturar os grupos de TODOS? Demora ~1-2 min.')) return;
  const st = document.getElementById('multiStatus');
  btn.disabled = true; st.textContent = '⏳ A ligar os números e a capturar… não feches esta página.';
  try {
    const r = await fetch('/api/central/capturar-slots', { method: 'POST' }).then(x => x.json());
    if (!r.ok && !r.resultados) { st.textContent = '❌ ' + (r.erro || 'falhou'); }
    else {
      const okN = (r.resultados || []).filter(x => !x.erro && x.grupos > 0).length;
      st.textContent = `✅ ${okN} número(s) capturaram · base agora com ${r.totalContactos} contactos · ` + (r.resultados || []).map(x => `S${x.slot}:${x.erro ? '⚠️' : '+' + x.novos}`).join(' ');
    }
  } catch (e) { st.textContent = '❌ ' + e.message; }
  btn.disabled = false;
  centralRefresh();
}
function centralRender() {
  const tb = document.getElementById('centralTbody');
  if (!_centralDados.length) { tb.innerHTML = '<tr><td colspan="7" class="muted">Base vazia — usa a captura com TODOS os números.</td></tr>'; document.getElementById('centralCount').textContent = ''; return; }
  const termo = (document.getElementById('centralBusca').value || '').toLowerCase().trim();
  let lista = _filtroDdd ? _centralDados.filter(c => c.dddRotulo === _filtroDdd) : _centralDados;
  if (termo) lista = lista.filter(c => c.busca.includes(termo) || (c.dddRotulo || '').toLowerCase().includes(termo) || (c.slots || []).some(s => ('slot' + s).includes(termo.replace('slot', ''))));
  tb.innerHTML = lista.map(c => `<tr data-busca="${c.busca}">
    <td><code>${c.num}</code></td><td>${c.nome || '—'}</td>
    <td><span class="badge">🌍 ${c.dddRotulo || '—'}</span> <small class="muted">${c.pais || ''}</small></td>
    <td>${(c.slots || []).map(s => `🧱${s}`).join(' ') || '—'}</td>
    <td>${c.grupos || '—'}${c.nGrupos > 3 ? ` <small class="muted">+${c.nGrupos - 3}</small>` : ''}</td>
    <td>${c.ts ? new Date(c.ts).toLocaleDateString('pt-PT') : '—'}</td>
    <td><button class="btn btn-sm" onclick="centralRemover('${c.num}')">Remover</button></td></tr>`).join('');
  document.getElementById('centralCount').textContent = lista.length + ' contactos' + (_filtroDdd ? ' (filtro ' + _filtroDdd + ')' : '');
}
function centralFiltrar() {
  const q = (document.getElementById('centralBusca').value || '').toLowerCase();
  document.querySelectorAll('#centralTbody tr[data-busca]').forEach(tr => { tr.style.display = tr.dataset.busca.includes(q) ? '' : 'none'; });
}
async function centralRemover(num) {
  if (!confirm('Remover ' + num + ' da base?')) return;
  await fetch('/api/central/remover', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ num }) });
  centralRefresh();
}
async function centralLimpar() {
  if (!confirm('APAGAR a base TODA?')) return;
  await fetch('/api/central/limpar', { method: 'POST' });
  centralRefresh();
}
// v12.9.24: auto-refresh 30s (a base vive sozinha com a captura passiva)
setInterval(centralRefresh, 30000);
centralRefresh();
</script>
<%- include('../partials/footer') %>
