<%- include('../partials/head') %>
<div class="app-shell">
  <%- include('../partials/sidebar') %>
  <main class="main">
    <header class="page-header">
      <div>
        <h1>🕸️ Central de Sessões</h1>
        <p class="muted">4 slots <strong>numerados para sempre</strong> — a conta nunca muda de slot; o marcador <strong>🟢 EM USO</strong> é que anda. As guardadas entram numa <strong>fila equilibrada</strong> (quem espera há mais tempo assume primeiro — desgaste repartido). O bot só «faz o contacto» às guardadas para manter a ligação viva (ronda a cada 30 min) e insiste ~2 dias nas sessões novas antes de as dar como mortas.</p>
      </div>
    </header>

    <div class="alert alert-info">
      <span>🛡️</span>
      <span><strong>Failover automático (v12.6):</strong> a troca de slot acontece SOZINHA quando —
      ① slot 1 banida/expirada (logout), ② conta restrita (403),
      ③ <strong>5 reconexões seguidas falhadas</strong>, ou ④ bot caído há mais de 10 min (vigia).
      A primeira slot guardada que responder assume de imediato — sem QR, sem tocar no painel.
      Esta página actualiza-se sozinha a cada 15s.</span>
    </div>

    <div class="card">
      <h2>➕ Adicionar sessão nova</h2>
      <form id="addForm" style="display:flex;gap:0.6rem;flex-wrap:wrap;align-items:end">
        <div class="form-group" style="flex:1;min-width:220px">
          <label>Número WhatsApp (com código do país)</label>
          <input type="text" id="inNumero" placeholder="244912345678" required />
        </div>
        <button type="submit" class="btn btn-primary">🔑 Gerar código de emparelhamento</button>
      </form>
      <div id="codigoBox" style="display:none;margin-top:1rem;text-align:center">
        <p class="muted">Abre o WhatsApp no número novo → <em>Aparelhos ligados</em> → <em>Ligar com código</em> e introduz:</p>
        <p class="muted" style="font-size:0.8rem">🔗 Este é <strong>O MESMO par code</strong> da página <em>Connect</em> — aparece nas duas em tempo real.</p>
        <div id="codigo" style="font-size:2rem;letter-spacing:0.3rem;font-weight:700;color:#0f0;background:#000;border:2px solid #0f0;border-radius:12px;padding:0.6rem 1rem;display:inline-block;font-family:monospace"></div>
        <p class="muted" id="codigoTimer">à espera do scan… (90s)</p>
      </div>
      <p class="muted" id="addStatus"></p>
    </div>

    <div class="grid" id="slotsGrid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem">
      <% const badge = (e) => e === 'ativa' ? '🟢 EM USO' : e === 'guardada' ? '🟦 NA FILA' : e === 'ligacao' ? '⏳ A LIGAR' : e === 'morta' ? '⛔ MORTA (2d retry…)' : '⬜ VAZIA'; %>
      <% slots.forEach(s => { %>
      <div class="card" style="border:1px solid <%= s.estado === 'ativa' ? '#00ff9d' : s.estado === 'guardada' ? '#00f0ff' : '#444' %>">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <h3 style="margin:0">SLOT <%= s.slot %></h3>
          <span class="badge"><%= badge(s.estado) %><%= s.proxima ? ' · ⏭️ PRÓXIMA' : '' %></span>
        </div>
        <p style="margin:0.6rem 0 0.2rem"><strong><%= s.numero %></strong></p>
        <p class="muted" style="font-size:0.82rem;margin:0">
          <% if (s.ultimaViva) { %>viva <%= new Date(s.ultimaViva).toLocaleString('pt-PT') %><br><% } %>
          <% if (s.ultimaProva) { %>último contacto: <%= new Date(s.ultimaProva).toLocaleString('pt-PT') %><br><% } %>
          <% if (s.motivo) { %>⚠️ <%= s.motivo %><br><% } %>
          <% if (s.emRetry) { %>🔁 retry termina <%= new Date(s.retryAte).toLocaleDateString('pt-PT') %> (<%= s.tentativas %>x)<% } %>
        </p>
        <div class="button-row" style="margin-top:0.8rem">
          <% if (s.slot !== 1 && s.estado !== 'vazia') { %>
            <button class="btn btn-sm btn-danger" onclick="remover(<%= s.slot %>)">🗑️ Remover</button>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>

    <div class="card">
      <h3>⚙️ Operações</h3>
      <div class="button-row">
        <button class="btn btn-secondary" onclick="rodar()">🔁 Rodar agora <span class="muted">(a 1ª da fila equilibrada que responda fica EM USO)</span></button>
        <button class="btn btn-secondary" onclick="recarregar()">🔄 Actualizar</button>
      </div>
      <p class="muted" id="opStatus"></p>
      <p class="muted" style="font-size:0.8rem">Estado actual do bot: <strong><%= botState.status || '—' %></strong></p>
    </div>
  </main>
</div>
<script>
  async function post(url, body) {
    const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
    return r.json().catch(() => ({ ok: false, motivo: 'resposta inválida' }));
  }
  function recarregar() { location.reload(); }

  document.getElementById('addForm').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const numero = document.getElementById('inNumero').value;
    const st = document.getElementById('addStatus');
    const btn = document.querySelector('#addForm button[type="submit"]');
    if (btn) { btn.disabled = true; btn.textContent = '⏳ a ligar ao WhatsApp… (10-30s)'; }
    st.textContent = '⏳ a abrir a ligação e a pedir o código ao WhatsApp… não feches esta página.';
    const r = await post('/dashboard/sessoes/adicionar', { numero });
    if (btn) { btn.disabled = false; btn.textContent = '🔑 Gerar código de emparelhamento'; }
    if (!r.ok) { st.textContent = '❌ ' + (r.motivo === 'sem-slot-livre' ? 'todos os slots ocupados — remove um primeiro' : r.motivo); return; }
    mostrarCodigo(r.slot, r.codigo);
  });

  // v12.9.26: código persistente na UI — mostra, conta o tempo e NUNCA é apagado por refresh
  let _timerScan = null;
  function mostrarCodigo(slot, codigo) {
    try { sessionStorage.setItem('darkPair', JSON.stringify({ slot, codigo, ate: Date.now() + 90000 })); } catch {}
    document.getElementById('codigoBox').style.display = 'block';
    document.getElementById('codigo').textContent = codigo;
    const st = document.getElementById('addStatus');
    st.textContent = '✅ slot ' + slot + ' — liga o número com o código acima';
    let falta = 90;
    clearInterval(_timerScan);
    _timerScan = setInterval(() => {
      falta--;
      const el = document.getElementById('codigoTimer');
      if (el) el.textContent = `à espera do scan… (${falta}s)`;
      if (falta <= 0) { clearInterval(_timerScan); if (el) el.textContent = '⏳ expirou — se não emparelhou, gera um código novo.'; }
    }, 1000);
  }
  // ao carregar: 1) sessionStorage (instantâneo), 2) estado.json (oficial, com timeout maior)
  (() => {
    try {
      const p = JSON.parse(sessionStorage.getItem('darkPair') || 'null');
      if (p && p.ate > Date.now()) mostrarCodigo(p.slot, p.codigo);
      else sessionStorage.removeItem('darkPair');
    } catch {}
  })();
  (async () => {
    try {
      const d = await fetch('/dashboard/sessoes/estado.json').then(x => x.json());
      const emLig = (d.slots || []).find(s => s.estado === 'ligacao' && s.codigo);
      if (emLig) mostrarCodigo(emLig.slot, emLig.codigo);
    } catch {}
  })();

  async function remover(slot) {
    if (!confirm('Remover a sessão do slot ' + slot + '?')) return;
    const r = await post('/dashboard/sessoes/remover/' + slot);
    document.getElementById('opStatus').textContent = r.ok ? '🗑️ slot removida' : '❌ ' + r.motivo;
    if (r.ok) setTimeout(recarregar, 800);
  }

  async function rodar() {
    document.getElementById('opStatus').textContent = '⏳ a sondar slots guardadas…';
    const r = await post('/dashboard/sessoes/rodar');
    document.getElementById('opStatus').textContent = r.ok
      ? '🔁 SLOT ' + r.promovida + ' (' + (r.numero || '?') + ') ficou EM USO — o bot reinicia em 3s'
      : '❌ ' + (r.motivo === 'sem-suplente-viva' ? 'nenhuma slot guardada está viva' : r.motivo);
    if (r.ok) setTimeout(recarregar, 7000);
  }

  // ── v12.6: AUTO-REFRESH — a grelha actualiza-se sozinha a cada 15s ──
  const BADGE = { ativa: '🟢 EM USO', guardada: '🟦 NA FILA', ligacao: '⏳ A LIGAR', morta: '⛔ MORTA (2d retry…)', vazia: '⬜ VAZIA' };
  const COR = { ativa: '#00ff9d', guardada: '#00f0ff', ligacao: '#ffd166', morta: '#ff4d6d', vazia: '#444' };
  const fmtData = (iso) => iso ? new Date(iso).toLocaleString('pt-PT') : null;

  function cartaoSlot(s) {
    const podeRemover = s.slot !== 1 && s.estado !== 'vazia';
    return '<div class="card" style="border:1px solid ' + (COR[s.estado] || '#444') + '">' +
      '<div style="display:flex;justify-content:space-between;align-items:center">' +
        '<h3 style="margin:0">SLOT ' + s.slot + '</h3>' +
        '<span class="badge">' + (BADGE[s.estado] || s.estado) + (s.proxima ? ' · ⏭️ PRÓXIMA' : '') + '</span>' +
      '</div>' +
      '<p style="margin:0.6rem 0 0.2rem"><strong>' + (s.numero || '(sem número)') + '</strong></p>' +
      '<p class="muted" style="font-size:0.82rem;margin:0">' +
        (s.ultimaViva ? 'viva ' + fmtData(s.ultimaViva) + '<br>' : '') +
        (s.ultimaProva ? 'último contacto: ' + fmtData(s.ultimaProva) + '<br>' : '') +
        (s.motivo ? '⚠️ ' + s.motivo + '<br>' : '') +
        (s.emRetry ? '🔁 retry termina ' + new Date(s.retryAte).toLocaleDateString('pt-PT') + ' (' + s.tentativas + 'x)' : '') +
      '</p>' +
      (podeRemover ? '<div class="button-row" style="margin-top:0.8rem"><button class="btn btn-sm btn-danger" onclick="remover(' + s.slot + ')">🗑️ Remover</button></div>' : '') +
    '</div>';
  }

  async function _actualizar() {
    try {
      const r = await fetch('/dashboard/sessoes/estado.json');
      const d = await r.json();
      if (!d.ok) return;
      const grid = document.getElementById('slotsGrid');
      if (grid && Array.isArray(d.slots) && d.slots.length) grid.innerHTML = d.slots.map(cartaoSlot).join('');
      // v12.9.27: NUNCA mais reload automático — só actualiza o que precisa
      const st = document.querySelector('.card p.muted strong');
      const botSt = d.bot?.status || '—';
      if (st && st.textContent !== botSt) st.textContent = botSt;
      // se há slot EM LIGAÇÃO com código e a caixa não está visível (reload manual), repõe o código
      const emLig = (d.slots || []).find(s => s.estado === 'ligacao' && s.codigo);
      if (emLig && document.getElementById('codigoBox').style.display !== 'block') mostrarCodigo(emLig.slot, emLig.codigo);
      else if (!emLig) { try { sessionStorage.removeItem('darkPair'); } catch {} }
    } catch {}
  }
  setInterval(_actualizar, 15000);
</script>
<%- include('../partials/footer') %>
