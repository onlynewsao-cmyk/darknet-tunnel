<%- include('../partials/head') %>
<div class="app-shell">
  <%- include('../partials/sidebar') %>
  <main class="main">
    <header class="page-header">
      <div>
        <h1>📡 C∆P Capture</h1>
        <p class="muted">Monitoriza perfis do Instagram e captura posts, reels, stories e highlights → WhatsApp + galeria</p>
      </div>
    </header>

    <div class="card">
      <h2>🔐 Contas Instagram (sessões)</h2>
      <p class="muted">Usa contas <b>secundárias</b>. Podes adicionar várias — o bot roda entre elas (menos bloqueios 429). A senha nunca é guardada; só o <code>sessionid</code>.</p>
      <div class="form-grid">
        <form id="capLoginPw" class="card" style="margin:0">
          <h3>Entrar com utilizador e senha</h3>
          <div class="form-group"><label>Utilizador</label><input type="text" id="igUser" placeholder="conta_secundaria" autocomplete="off" /></div>
          <div class="form-group"><label>Senha</label><input type="password" id="igPass" autocomplete="new-password" /></div>
          <button type="submit" class="btn btn-primary">🔐 Entrar</button>
          <small class="muted">Se a conta tiver 2FA ou o Instagram pedir verificação, usa o sessionid ao lado.</small>
        </form>
        <form id="capLoginSid" class="card" style="margin:0">
          <h3>Ou colar o sessionid</h3>
          <div class="form-group"><label>sessionid</label><input type="text" id="igSid" placeholder="12345678%3AabcDEF...%3A28%3A..." autocomplete="off" /></div>
          <button type="submit" class="btn btn-primary">➕ Adicionar sessão</button>
          <small class="muted">Chrome PC: instagram.com logado → F12 → Application → Cookies → instagram.com → <code>sessionid</code>. Telemóvel: Kiwi/Firefox + "Cookie Editor". Também aceita <code>IG_SESSIONID</code> no .env.</small>
        </form>
      </div>
      <div id="capLoginMsg" class="muted" style="margin-top:8px"></div>
      <table class="table" style="margin-top:12px">
        <thead><tr><th>Conta</th><th>Estado</th><th>Adicionada</th><th></th></tr></thead>
        <tbody id="sessTbody">
          <% sessoes.forEach(s => { %>
            <tr><td>@<%= s.user || '?' %></td><td><%= s.ok ? '🟢 OK' : '🔴 ' + s.lastErr %></td><td><%= s.addedAt ? new Date(s.addedAt).toLocaleString('pt-PT') : '' %></td><td><button class="btn btn-sm" onclick="capLogout('<%= s.user %>')">Remover</button></td></tr>
          <% }) %>
          <% if (!sessoes.length) { %><tr><td colspan="4" class="muted">Nenhuma sessão — sem login só há 12 posts públicos por perfil e o limite 429 é baixo.</td></tr><% } %>
        </tbody>
      </table>
      <button class="btn" onclick="capTestar()">🧪 Testar sessões</button>
    </div>

    <div class="card">
      <h2>🎯 Alvos monitorizados</h2>
      <form id="capAddAlvo" class="form-grid">
        <div class="form-group"><label>Perfil</label><input type="text" id="alvoUser" placeholder="@veigh" /></div>
        <div class="form-group"><label>Destino WhatsApp (JID do grupo / número)</label><input type="text" id="alvoDest" placeholder="120363xxxx@g.us ou 2449xxxxxxx" /></div>
        <div class="form-group" style="align-self:end"><button type="submit" class="btn btn-primary">➕ Monitorizar</button></div>
      </form>
      <table class="table">
        <thead><tr><th>Alvo</th><th>Auto</th><th>Intervalo</th><th>Destinos</th><th>Baixados / Falhados / Enviados</th><th>Última</th><th></th></tr></thead>
        <tbody id="alvosTbody">
          <% alvos.forEach(t => { %>
            <tr>
              <td>@<%= t.username %><%= t.nome ? ' — ' + t.nome : '' %></td>
              <td><%= t.auto ? '🟢' : '⏸️' %></td>
              <td><%= t.intervaloMin %> min</td>
              <td><%= (t.destinos || []).map(d => d.split('@')[0]).join(', ') || '—' %></td>
              <td><%= (t.stats||{}).baixados||0 %> / <%= (t.stats||{}).falhados||0 %> / <%= (t.stats||{}).enviados||0 %></td>
              <td><%= t.lastCheck ? new Date(t.lastCheck).toLocaleString('pt-PT') : 'nunca' %><%= t.lastResult && t.lastResult.erro ? ' ⚠️ ' + t.lastResult.erro.slice(0, 60) : '' %></td>
              <td><button class="btn btn-sm" onclick="capCheck('<%= t.username %>')">Verificar</button> <button class="btn btn-sm" onclick="capDel('<%= t.username %>')">Remover</button></td>
            </tr>
          <% }) %>
          <% if (!alvos.length) { %><tr><td colspan="7" class="muted">Nenhum alvo. Também podes usar <code>!cap add @veigh</code> no WhatsApp.</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>📜 Últimas capturas</h2>
      <table class="table">
        <thead><tr><th>Hora</th><th>Alvo</th><th>Tipo</th><th>Item</th><th>Estado</th><th>Detalhe</th></tr></thead>
        <tbody>
          <% log.forEach(l => { %>
            <tr><td><%= new Date(l.ts).toLocaleTimeString('pt-PT') %></td><td><%= (l.target||'').split(':')[1] || l.target %></td><td><%= l.tipo %></td><td><%= l.item %></td><td><%= ({baixado:'✅',parcial:'🟡',falhou:'❌',enviado:'📤',erro:'⚠️'})[l.status] || '•' %> <%= l.status %></td><td class="muted"><%= String(l.detalhe||'').slice(0, 80) %></td></tr>
          <% }) %>
          <% if (!log.length) { %><tr><td colspan="6" class="muted">Sem registos.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </main>
</div>

<script>
  const msgEl = document.getElementById('capLoginMsg');
  const post = async (url, body) => { const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }); const j = await r.json().catch(() => ({})); if (!r.ok) throw new Error(j.error || ('HTTP ' + r.status)); return j; };
  const done = (t, ok = true) => { msgEl.textContent = t; msgEl.style.color = ok ? '#3ddc84' : '#ff6b6b'; if (ok) setTimeout(() => location.reload(), 1200); };
  document.getElementById('capLoginPw').addEventListener('submit', async (e) => {
    e.preventDefault(); msgEl.textContent = '🔐 A entrar…';
    try { const j = await post('/api/cap/login', { username: igUser.value.trim(), password: igPass.value }); igPass.value = ''; done('✅ Logado como @' + (j.user || igUser.value)); }
    catch (err) { done('❌ ' + err.message, false); }
  });
  document.getElementById('capLoginSid').addEventListener('submit', async (e) => {
    e.preventDefault(); msgEl.textContent = '🔐 A validar…';
    try { const j = await post('/api/cap/login', { sessionid: igSid.value.trim() }); igSid.value = ''; done(j.validado ? '✅ Logado como @' + j.user : '🟡 Guardada sem validar: ' + j.aviso); }
    catch (err) { done('❌ ' + err.message, false); }
  });
  async function capLogout(user) { try { await post('/api/cap/logout', { user }); location.reload(); } catch (e) { alert(e.message); } }
  async function capTestar() { msgEl.textContent = '🧪 A testar…'; try { const j = await post('/api/cap/testar', {}); msgEl.textContent = j.resultados.map(r => (r.ok ? '🟢 @' : '🔴 @') + r.user + (r.erro ? ' — ' + r.erro : '')).join(' · ') || 'Sem sessões'; setTimeout(() => location.reload(), 2500); } catch (e) { done('❌ ' + e.message, false); } }
  document.getElementById('capAddAlvo').addEventListener('submit', async (e) => {
    e.preventDefault();
    let d = alvoDest.value.trim(); if (/^\d{8,14}$/.test(d)) d += '@s.whatsapp.net'; else if (/^\d{15,}$/.test(d)) d += '@g.us';
    try { await post('/api/cap/alvo', { alvo: alvoUser.value.trim(), destino: d || undefined }); location.reload(); } catch (err) { alert(err.message); }
  });
  async function capDel(u) { if (!confirm('Remover @' + u + '?')) return; await post('/api/cap/alvo', { alvo: u, acao: 'del' }); location.reload(); }
  async function capCheck(u) { try { const r = await post('/api/cap/check', { alvo: u }); alert(r.erro ? '⚠️ ' + r.erro : `@${u}: ${r.novos||0} novos · ${r.baixados||0} baixados · ${r.falhados||0} falhados · ${r.enviados||0} enviados${r.primed ? ' (1.ª verificação: histórico marcado)' : ''}`); location.reload(); } catch (e) { alert(e.message); } }
</script>
<%- include('../partials/footer') %>
