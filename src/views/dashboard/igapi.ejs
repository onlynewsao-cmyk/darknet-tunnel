<%- include('../partials/head') %>
<div class="app-shell">
  <%- include('../partials/sidebar') %>
  <main class="main">
    <header class="page-header">
      <div>
        <h1>🛠️ IG APIs</h1>
        <p class="muted">As NOSSAS APIs verdadeiras — dados reais do Instagram por todas as vias (API → APP → graphql → página → resgate). Autenticação: a tua sessão owner do painel.</p>
      </div>
    </header>

    <div class="card">
      <h2>🌐 Base da API</h2>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <code id="baseApi" style="flex:1;min-width:260px;padding:10px;border-radius:8px;background:rgba(255,255,255,.06);word-break:break-all"></code>
        <button class="btn" onclick="copiarBase()">📋 Copiar</button>
      </div>
      <small class="muted">Consumo externo: faz login no painel e usa o cookie da sessão (<code>Cookie: connect.sid=…</code>). Dentro do painel os botões Testar já vão autenticados.</small>
      <div style="display:flex;gap:8px;align-items:center;margin-top:12px;flex-wrap:wrap">
        <label><b>@user para os testes:</b></label>
        <input type="text" id="igUser" value="veigh" style="width:180px;padding:8px;border-radius:8px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);color:inherit" />
      </div>
    </div>

    <div class="card">
      <h2>📡 Endpoints <small class="muted" id="resumo"></small></h2>
      <div id="lista" style="display:grid;gap:12px"></div>
    </div>

    <div class="card">
      <h2>🧪 Última resposta</h2>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px">
        <span id="stChip" class="muted">—</span>
        <button class="btn" onclick="copiarResp()">📋 Copiar JSON</button>
      </div>
      <pre id="saida" style="max-height:420px;overflow:auto;background:rgba(0,0,0,.35);padding:12px;border-radius:8px;font-size:12px;white-space:pre-wrap;word-break:break-all">Testa um endpoint acima ⤴</pre>
    </div>
  </main>
</div>
<script>
  const OWNER = '<%= owner.number %>';
  const ENDPOINTS = [
    { sec: '📡 Instagram — dados reais' },
    { id: 'perfil',    path: '/api/ig/perfil/USER?limit=6',  desc: 'Perfil completo + últimos posts (todas as vias + resgate automático)' },
    { id: 'stats',     path: '/api/ig/stats/USER',           desc: 'SÓ os números verdadeiros: seguidores, seguindo, posts + fontes' },
    { id: 'posts',     path: '/api/ig/posts/USER?limit=12',  desc: 'Posts do feed com URLs directos das mídias' },
    { id: 'reels',     path: '/api/ig/reels/USER?limit=12',  desc: 'Reels com URLs de vídeo directos' },
    { id: 'stories',   path: '/api/ig/stories/USER',         desc: 'Stories ACTIVOS agora, com URLs directos' },
    { id: 'highlights',path: '/api/ig/highlights/USER',      desc: 'Destaques (álbuns + itens)' },
    { id: 'tudo',      path: '/api/ig/tudo/USER',            desc: 'MEGA: perfil + posts + reels + stories + highlights num só pedido' },
    { id: 'buscar',    path: '/api/ig/buscar/QUERY',         desc: 'Pesquisa de utilizadores por nome (top 10)' },
    { id: 'lote',      path: '/api/ig/lote/USER,pinkchyu',   desc: 'Lote: stats de até 10 perfis num pedido (ritmo humano)' },
    { id: 'comparar',  path: '/api/ig/comparar/USER,nennyfans', desc: 'Compara 2 perfis: seguidores/posts/vencedor' },
    { id: 'canal',     path: '/api/ig/canal/USER',           desc: 'Canal de difusão do criador (best-effort)' },
    { sec: '📡 Monitorização + Webhooks' },
    { id: 'monitor',   path: '/api/ig/monitor',              desc: 'Alvos monitorizados + estatísticas de captura' },
    { id: 'monadd',    path: '/api/ig/monitor/add',  method: 'POST', body: (u) => ({ user: '@' + u }), desc: 'ADICIONA alvo à monitorização (captura automática → WhatsApp + webhook)' },
    { id: 'mondel',    path: '/api/ig/monitor/del',  method: 'POST', body: (u) => ({ user: '@' + u }), desc: 'Remove alvo da monitorização' },
    { id: 'whooks',    path: '/api/ig/webhooks',             desc: 'Webhooks registados' },
    { id: 'whadd',     path: '/api/ig/webhook',      method: 'POST', promptUrl: true, desc: 'Regista webhook: o CAP faz POST JSON a cada item capturado (tempo real nos TEUS sistemas)' },
    { id: 'whdel',     path: '/api/ig/webhook/remover', method: 'POST', promptUrl: true, desc: 'Remove um webhook' },
    { sec: '💬 WhatsApp — o bot responde às tuas apps' },
    { id: 'waestado',  path: '/api/wa/estado',               desc: 'Estado do WhatsApp: ligado, mensagens, comandos, uptime' },
    { id: 'waenviar',  path: '/api/wa/enviar',       method: 'POST', body: (u) => ({ para: OWNER, texto: 'Teste das APIs DARK ✅ ' + new Date().toLocaleString() }), desc: 'ENVIA texto/mídia para qualquer número/grupo (midia+tipo opcionais)' },
    { id: 'wagrupos',  path: '/api/wa/grupos',               desc: 'Todos os grupos: id, nome, nº de participantes' },
    { id: 'waconts',   path: '/api/wa/contactos',            desc: 'Central de contactos: total, grupos, actualização' },
    { sec: '🖥️ Sistema' },
    { id: 'sestado',   path: '/api/sistema/estado',          desc: 'Versão, uptime, memória, WhatsApp, IG (sessões/alvos/webhooks)' },
    { id: 'slog',      path: '/api/sistema/log?n=30',        desc: 'Últimos N eventos do CAP' },
    { id: 'sessoes',   path: '/api/ig/sessoes',              desc: 'Estado do pool de sessões IG (rotação anti-429)' },
    { id: 'cachelim',  path: '/api/ig/cache/limpar', method: 'POST', desc: 'Limpa as caches de perfis/stats/html' },
  ];
  const base = () => location.origin;
  const user = () => (document.getElementById('igUser').value || 'veigh').replace(/^@/, '').trim();
  document.getElementById('baseApi').textContent = base() + '/api/ig';
  document.getElementById('resumo').textContent = ENDPOINTS.length + ' APIs • dados reais';
  const lista = document.getElementById('lista');
  ENDPOINTS.forEach(e => {
    if (e.sec) {
      const h = document.createElement('h3');
      h.textContent = e.sec;
      h.style.cssText = 'margin:8px 0 -4px;opacity:.85';
      lista.appendChild(h);
      return;
    }
    const card = document.createElement('div');
    card.className = 'card'; card.style.cssText = 'margin:0';
    const rota = e.path.replace('USER', '@' + user()).replace('QUERY', user()).replace('URL_IG', 'https://…cdninstagram…jpg');
    const metodo = e.method || 'GET';
    const cor = metodo === 'POST' ? '#c70' : '#0a7';
    card.innerHTML = `
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <span style="background:${cor};font-weight:700;padding:2px 8px;border-radius:6px;font-size:12px">${metodo}</span>
        <code style="flex:1;min-width:220px;word-break:break-all">${rota}</code>
        <button class="btn btn-primary" onclick="testar('${e.id}')">▶ Testar</button>
        <button class="btn" onclick="copiarCurl('${e.id}')">📋 curl</button>
      </div>
      <small class="muted">${e.desc}</small>`;
    card.dataset.ep = e.id;
    lista.appendChild(card);
  });
  let ultima = '';
  async function testar(id) {
    const e = ENDPOINTS.find(x => x.id === id);
    if (!e || e.sec) return;
    let rota = e.path.replace('USER', encodeURIComponent(user())).replace('QUERY', encodeURIComponent(user()));
    const opts = { headers: { Accept: 'application/json' } };
    if (e.method === 'POST') {
      opts.method = 'POST';
      opts.headers['Content-Type'] = 'application/json';
      let body = {};
      if (e.promptUrl) {
        const url = prompt('URL do webhook (https://…):', '');
        if (!url) return;
        body = { url };
      } else if (e.body) body = e.body(user());
      opts.body = JSON.stringify(body);
    }
    const chip = document.getElementById('stChip');
    chip.textContent = '⏳ a correr…'; chip.className = 'muted';
    const t0 = performance.now();
    try {
      const r = await fetch(rota, opts);
      const j = await r.json().catch(() => ({}));
      const ms = Math.round(performance.now() - t0);
      chip.textContent = `HTTP ${r.status} · ${ms}ms · ${j.ok === true ? '✅ ok' : j.ok === false ? '⚠️ vazio/erro honesto' : '?'}`;
      chip.className = j.ok === true ? '' : 'muted';
      ultima = JSON.stringify(j, null, 2);
      document.getElementById('saida').textContent = ultima.slice(0, 20000) || '{}';
    } catch (err) {
      chip.textContent = '❌ ' + err.message;
      document.getElementById('saida').textContent = String(err);
    }
  }
  function copiarBase() { navigator.clipboard.writeText(base() + '/api/ig'); }
  function copiarResp() { navigator.clipboard.writeText(ultima || ''); }
  function copiarCurl(id) {
    const e = ENDPOINTS.find(x => x.id === id);
    if (!e || e.sec) return;
    let rota = e.path.replace('USER', encodeURIComponent(user())).replace('QUERY', encodeURIComponent(user()));
    let cmd = `curl -b "connect.sid=TEU_COOKIE" "${base()}${rota}"`;
    if (e.method === 'POST') {
      const body = e.promptUrl ? '{ "url": "https://teu-sistema/webhook" }' : JSON.stringify(e.body ? e.body(user()) : {});
      cmd = `curl -X POST -b "connect.sid=TEU_COOKIE" -H "Content-Type: application/json" -d '${body}' "${base()}${rota}"`;
    }
    navigator.clipboard.writeText(cmd);
  }
</script>
