<!-- ═══ TOPBAR (v4.0 DARK OS) ═══ -->
<header class="topbar">
  <button class="menu-toggle" onclick="openSidebar()" aria-label="Menu">☰</button>
  <div class="topbar-title"><%= title %></div>
  <div class="topbar-right">
    <div class="bot-status" id="topStatus" title="Estado do bot em tempo real">
      <span class="status-dot" id="topStatusDot"></span>
      <span id="topStatusText">…</span>
    </div>
    <span class="topbar-clock" id="topClock">--:--</span>
    <div class="topbar-avatar" title="<%= user.name || user.username %>"><%= (user.name || user.username).charAt(0).toUpperCase() %></div>
  </div>
</header>


<aside class="sidebar">
  <div class="sidebar-brand">
    <div class="brand-logo">
      <img src="/img/logo.jpg" alt="Logo" style="width:100%;height:100%;object-fit:cover;border-radius:inherit" />
    </div>
    <div style="min-width:0">
      <div class="brand-name"><%= bot.name %></div>
      <div class="brand-owner">⚡ by <%= owner.name %></div>
    </div>
  </div>

  <nav class="sidebar-nav">
    <%
    /* ── DARK OS v4.0 — mapa completo das funcionalidades do bot ── */
    const _sec = (t) => { %><div class="sidebar-section"><%= t %></div><% };
    const _nav = (href, label, svg, badge) => {
      const on = href === '/dashboard' ? currentPath === '/dashboard'
        : currentPath.startsWith(href);
    %><a href="<%= href %>" class="<%= on ? 'active' : '' %>"><span class="icon"><svg viewBox="0 0 24 24"><%= svg %></svg></span><span class="truncate"><%= label %></span><% if (badge) { %><span class="nav-badge"><%= badge %></span><% } %></a><% };
    %>

    <% _sec('Visão Geral'); %>
    <% _nav('/dashboard', 'Dashboard',
      '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>'); %>
    <% if (user.role === 'owner' || user.role === 'admin') { %>
      <% _nav('/dashboard/stats', 'Estatísticas',
        '<path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/>'); %>
      <% _nav('/dashboard/console', 'Console ao Vivo',
        '<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>'); %>
    <% } %>

    <% if (user.role === 'owner' || user.role === 'admin') { %>
      <% _sec('Conexão'); %>
      <% _nav('/dashboard/connect', 'Conectar Bot',
        '<path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><circle cx="12" cy="20" r="1" fill="currentColor" stroke="none"/>'); %>
      <% _nav('/dashboard/sessoes', 'Sessões · Failover', '<circle cx="12" cy="12" r="3"/><circle cx="4" cy="6" r="2"/><circle cx="20" cy="6" r="2"/><circle cx="4" cy="18" r="2"/><circle cx="20" cy="18" r="2"/><path d="M6 7l4 3.5M18 7l-4 3.5M6 17l4-3.5M18 17l-4-3.5"/>', '4'); %>

      <% _sec('Contas & Dados'); %>
      <% _nav('/dashboard/central', 'Central de Contas',
        '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>'); %>
      <% _nav('/dashboard/groups', 'Grupos',
        '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>'); %>
      <% _nav('/dashboard/media', 'Galeria de Mídias',
        '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>'); %>
      <% _nav('/dashboard/nuvem', 'Nuvem do Bot',
        '<path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>'); %>

      <% _sec('Ferramentas'); %>
      <% _nav('/dashboard/cap', 'CAP · Stories',
        '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3" fill="currentColor" stroke="none"/>'); %>
      <% _nav('/dashboard/igapi', 'IG APIs & Chaves',
        '<path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>'); %>
      <% _nav('/dashboard/internet', 'Downloads & Buscas',
        '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>'); %>
      <% _nav('/dashboard/broadcast', 'Broadcast',
        '<path d="M3 11l18-7-7 18-2.5-7.5L3 11z"/>'); %>
      <% _nav('/dashboard/schedule', 'Agenda',
        '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>'); %>

      <% _sec('Bot'); %>
      <% _nav('/dashboard/commands', 'Comandos',
        '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>'); %>
      <% _nav('/dashboard/control', 'Painel de Controle',
        '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>'); %>
      <% _nav('/dashboard/ia', 'Aura · IA',
        '<path d="M12 2a7 7 0 0 1 7 7c0 2.38-1.19 4.47-3 5.74V17a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-2.26C6.19 13.47 5 11.38 5 9a7 7 0 0 1 7-7z"/><line x1="9" y1="21" x2="15" y2="21"/>'); %>
      <% _nav('/dashboard/board', 'Board',
        '<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/>'); %>
      <% _nav('/dashboard/settings', 'Configurações',
        '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>'); %>
    <% } %>

    <% _sec('Minha Conta'); %>
    <% _nav('/dashboard/decrypter', 'VPN Decrypter',
      '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>'); %>
    <% _nav('/dashboard/profile', 'Meu Perfil',
      '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>'); %>
    <% _nav('/dashboard/add-bot', 'Adicionar ao Grupo',
      '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>'); %>
    <% if (user.role !== 'owner' && user.role !== 'admin') { %>
      <% _nav('/dashboard/subscribe', 'Assinar Premium',
        '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>'); %>
    <% } %>

    <% if (user.role === 'owner' || user.role === 'admin') { %>
      <% _sec('Sistema'); %>
      <% _nav('/dashboard/users', 'Usuários',
        '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>'); %>
      <% _nav('/dashboard/payments', 'Pagamentos',
        '<rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/>'); %>
      <% _nav('/dashboard/backup', 'Backup',
        '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>'); %>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <div class="user-card">
      <div class="user-avatar"><%= (user.name || user.username).charAt(0).toUpperCase() %></div>
      <div style="flex:1;min-width:0">
        <div class="user-name truncate"><%= user.name || user.username %></div>
        <div class="user-role role-<%= user.role %>">
          <% if (user.role === 'owner') { %>👑 Dono<% } else if (user.role === 'admin') { %>🛡️ Admin<% } else if (user.role === 'premium') { %>⭐ Premium<% } else { %>🆓 Free<% } %>
        </div>
      </div>
    </div>
    <a href="/logout" class="btn btn-ghost btn-sm btn-block">Sair da conta</a>
  </div>
</aside>
