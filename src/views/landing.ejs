<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= siteMeta?.title || bot.name %></title>
  <meta name="description" content="<%= siteMeta?.description || 'DARK BOT - Bot WhatsApp profissional' %>">
  <meta name="theme-color" content="#05070d">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { margin:0; }
    .land {
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      flex-direction: column; text-align: center; padding: 2.5rem 1.2rem;
      position: relative; overflow: hidden;
    }
    .land-ico {
      width: 84px; height: 84px; border-radius: 24px; overflow: hidden;
      border: 1px solid rgba(139,92,246,.45); box-shadow: 0 8px 32px -8px rgba(139,92,246,.55);
      margin-bottom: 1.4rem;
    }
    .land-ico img { width: 100%; height: 100%; object-fit: cover; }
    .land h1 {
      font-family: 'Sora', sans-serif;
      font-size: clamp(2.2rem, 7vw, 3.6rem);
      margin: 0 0 1rem; letter-spacing: -0.03em; line-height: 1.05;
      color: #f2f5fc;
    }
    .land > .land-sub { font-size: 1.05rem; color: #94a0b8; max-width: 520px; margin: 0 auto 2rem; line-height: 1.6; }
    .btn-hero {
      display: inline-block; padding: .95rem 2.4rem;
      background: linear-gradient(135deg, #8b5cf6, #22d3ee);
      color: #fff; border-radius: 14px; text-decoration: none; font-weight: 700;
      font-size: 1rem; transition: .25s; box-shadow: 0 8px 26px -12px rgba(139,92,246,.5);
      letter-spacing: .01em;
    }
    .btn-hero:hover { transform: translateY(-3px); box-shadow: 0 18px 52px -10px rgba(34,211,238,.5); color: #fff; }
    .land .tag {
      display: inline-block; padding: .35rem .95rem; border-radius: 99px;
      font-size: .78rem; font-weight: 600; margin: .28rem;
      background: rgba(139,92,246,.08); border: 1px solid rgba(139,92,246,.3); color: #c4b5fd;
    }
    .land .features { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin: 3rem 0 0; }
    .land .feat {
      background: rgba(15,20,36,.75); border: 1px solid rgba(148,163,196,.16);
      border-radius: 18px; padding: 1.4rem 1.6rem; max-width: 210px; text-align: center;
      backdrop-filter: blur(10px); transition: .25s; box-shadow: 0 12px 40px -16px rgba(0,0,0,.6);
    }
    .land .feat:hover { transform: translateY(-4px); border-color: rgba(139,92,246,.5); }
    .land .feat .icon { font-size: 1.9rem; margin-bottom: .5rem; }
    .land .feat h3 { margin: 0 0 .4rem; font-size: .95rem; color: #e7ecf5; font-family: 'Sora', sans-serif; }
    .land .feat p { margin: 0; font-size: .8rem; color: #94a0b8; }
    .land footer { margin-top: 3rem; color: #64708a; font-size: .82rem; }
    .land footer strong { color: #a78bfa; }
  </style>
</head>
<body>
  <div class="land">
    <div class="land-ico"><img src="/img/logo.jpg" alt="Logo"></div>
    <h1><%= bot.name %></h1>
    <p class="land-sub">Bot WhatsApp profissional: dashboard DARK OS, IA com memória, failover de 4 sessões, downloads, stickers e 271+ comandos.</p>
    <a href="/login" class="btn-hero">Entrar no Dashboard →</a>

    <div style="margin-top:2.2rem">
      <span class="tag">🧠 IA com Memória</span>
      <span class="tag">🕸️ Failover 4 Slots</span>
      <span class="tag">📥 Downloads YT</span>
      <span class="tag">🎨 Stickers</span>
      <span class="tag">🎮 Jogos</span>
      <span class="tag">💰 Dark Bank</span>
      <span class="tag">🛡️ Anti-spam</span>
      <span class="tag">🗂️ Central de Contas</span>
      <span class="tag">🔓 VPN Decrypt</span>
    </div>

    <div class="features">
      <div class="feat"><div class="icon">⚡</div><h3>Rápido</h3><p>Render Free + keep-alive</p></div>
      <div class="feat"><div class="icon">🛡️</div><h3>Seguro</h3><p>Sem chaves no GitHub</p></div>
      <div class="feat"><div class="icon">🎨</div><h3>Personalizável</h3><p>10 temas de menu</p></div>
      <div class="feat"><div class="icon">👑</div><h3>Completo</h3><p>271+ comandos</p></div>
    </div>

    <footer>Criado por <strong><%= owner.name %></strong> · Dark Net Engine 🕸️</footer>
  </div>
</body>
</html>
